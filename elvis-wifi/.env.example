
PORT=3000
BASE_URL=https://your-public-domain.example

# Daraja: use sandbox first. Change to production only after Safaricom approval.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace_me
MPESA_CONSUMER_SECRET=replace_me
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace_me
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_SECRET=use_a_long_random_secret
MPESA_CALLBACK_URL=https://your-public-domain.example/api/mpesa/callback/replace_with_same_secret

# MikroTik RouterOS 7 REST API. Use HTTPS and a restricted API user.
MIKROTIK_BASE_URL=https://192.168.88.1
MIKROTIK_USERNAME=elvis-hotspot-api
MIKROTIK_PASSWORD=replace_me
MIKROTIK_HOTSPOT_PROFILE=default

# The exact origin of the RouterOS captive-portal login URL, e.g. http://192.168.88.1
HOTSPOT_LOGIN_ORIGIN=http://192.168.88.1

# Admin dashboard (change this to a long unique password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_long_random_password
